#!/bin/sh
# Block commits that contain secrets. Uses gitleaks when installed, otherwise a pattern check.
if command -v gitleaks >/dev/null 2>&1; then
  exec gitleaks git --pre-commit --staged --redact --no-banner
fi
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0
if git diff --cached -U0 | grep -nE '^\+.*(KIE_AI_API_KEY|API_KEY|SECRET|TOKEN)\s*=\s*[A-Za-z0-9_\-]{16,}|^\+.*(sk-[A-Za-z0-9]{20,}|ghp_[A-Za-z0-9]{30,})'; then
  echo "pre-commit: this looks like a secret. Remove it, or install gitleaks for a precise check." >&2
  exit 1
fi
if echo "$staged" | grep -qE '(^|/)\.env($|\.)' && ! echo "$staged" | grep -qx '.env.example'; then
  echo "pre-commit: refusing to commit a .env file." >&2
  exit 1
fi
